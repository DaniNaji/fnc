# =================================================================
# BEISPIEL-UMGEBUNGSVARIABLEN (NIEMALS ECHTE KEYS HIER SPEICHERN)
# Kopiere diese Datei zu '.env' und trage dort deine echten Werte ein.
# Die Datei '.env' wird durch .gitignore automatisch vom Git-Commit ausgeschlossen!
# =================================================================

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Sicherheit
JWT_SECRET=generiere-hier-einen-langen-sicheren-32-zeichen-schluessel
JWT_EXPIRES_IN=7d

# Mistral AI Konfiguration
# Auf 'true' lassen, solange du die App mit Mock-Daten testen möchtest:
USE_MOCK_AI=true

# Sobald du den echten Key hast, USE_MOCK_AI=false setzen und deinen Key eintragen:
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
